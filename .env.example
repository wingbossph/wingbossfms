# Postgres. On Supabase: DATABASE_URL = pooled (port 6543, ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432), used for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wingboss"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wingboss"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Set to your deployed URL in production (Vercel sets this automatically when AUTH_TRUST_HOST=true)
AUTH_TRUST_HOST=true

# Seed: initial owner login (change the password after first login)
SEED_OWNER_EMAIL="owner@wingboss.ph"
SEED_OWNER_PASSWORD="ChangeMe123!"
